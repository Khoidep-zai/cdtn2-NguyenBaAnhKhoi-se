# ========================================================
# ENVIRONMENT CONFIGURATION - NHÓM 8 FREELANCE PLATFORM
# ========================================================

# 1. Chọn loại CSDL: "mysql" hoặc "postgres"
DB_TYPE=mysql
SPRING_PROFILES_ACTIVE=mysql

# 2. Cấu hình kết nối Database (Password: 12345)
DB_HOST=localhost
DB_NAME=freelance_db
DB_PASSWORD=12345

# Tùy chọn 1: Dùng MySQL (Port 3306, user root)
DB_PORT=3306
DB_USER=root

# Tùy chọn 2: Dùng PostgreSQL (Đổi sang nếu muốn dùng PostgreSQL)
# DB_TYPE=postgres
# SPRING_PROFILES_ACTIVE=postgres
# DB_PORT=5433
# DB_USER=postgres

# 3. Backend Spring Boot Config
BACKEND_PORT=8080
SERVER_PORT=8080
JWT_SECRET=9a7f8e3b2c1d0f5e4a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f
JWT_EXPIRATION_MS=86400000

# 4. Frontend React Config
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api/v1
