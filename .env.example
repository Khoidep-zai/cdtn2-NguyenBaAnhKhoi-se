# ========================================================
# ENVIRONMENT CONFIGURATION - NHÓM 8 FREELANCE PLATFORM
# Chuẩn hóa khởi chạy 2 lệnh theo kiến trúc CDTN1 & CDTN2 Track SE
# ========================================================

# 1. Chọn loại CSDL: "postgres" (mặc định khuyến nghị) hoặc "mysql"
DB_TYPE=postgres
SPRING_PROFILES_ACTIVE=postgres

# 2. Cấu hình kết nối Database PostgreSQL
DB_HOST=postgres_db
DB_PORT=5432
DB_NAME=freelance_db
DB_USER=postgres
DB_PASSWORD=12345
POSTGRES_PORT=5432

# 3. Backend Spring Boot REST API
BACKEND_PORT=8080
SERVER_PORT=8080
JWT_SECRET=9a7f8e3b2c1d0f5e4a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f
JWT_EXPIRATION_MS=86400000

# 4. Frontend Web SPA & Port Mapping
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api/v1
