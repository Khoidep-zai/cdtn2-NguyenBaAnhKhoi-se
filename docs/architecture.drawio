        </mxCell>
        <mxCell id="T3_2" value="Ràng buộc &amp;amp; hiệu năng&lt;br&gt;ACID, khóa ngoại, 13 B-Tree Index, UNIQUE (job_id, student_id),&lt;br&gt;UNIQUE (job_id, reviewer_id), CHECK rating 1-5" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="T3">
