        <mxCell id="T2_c2" value="BCrypt Password Encoder&lt;br&gt;(Salt = 10)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="T2">
