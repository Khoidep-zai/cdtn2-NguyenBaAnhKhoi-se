        </mxCell>
        <mxCell id="T3_h" value="&lt;b&gt;TẦNG 3: DỮ LIỆU (DATA TIER) - Container: freelance-db (cổng 5432)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontColor=#000000;fontSize=11;align=left;fontSize=12;" vertex="1" parent="T3">
          <mxGeometry x="12" y="6" width="1090" height="26" as="geometry" />
        </mxCell>
        <mxCell id="T3_0" value="PostgreSQL 16 (Production / Docker)&lt;br&gt;7 bảng: roles, users, categories, jobs,&lt;br&gt;applications, reviews, notifications" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="T3">
          <mxGeometry x="20" y="44" width="410" height="76" as="geometry" />
        </mxCell>
        <mxCell id="T3_1" value="H2 In-Memory&lt;br&gt;(Dev Fallback)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="T3">
