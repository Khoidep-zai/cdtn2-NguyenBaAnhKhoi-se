<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="architecture_marketplace" name="Kiến trúc hệ thống 3 tầng">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="980" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b style=&quot;font-size:16px&quot;&gt;SƠ ĐỒ KIẾN TRÚC HỆ THỐNG 3 TẦNG (THREE-TIER ARCHITECTURE)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;Dự án: Nền tảng quản lý freelance &amp;amp; marketplace việc làm part-time cho sinh viên | Nhóm 8 | SRS v1.2&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="users" value="NGƯỜI DÙNG - Trình duyệt web&lt;br&gt;(Khách vãng lai · Sinh viên · Nhà tuyển dụng · Quản trị viên)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1120" height="56" as="geometry" />
        </mxCell>
        <mxCell id="T1" value="" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="1120" height="136" as="geometry" />
        </mxCell>
        <mxCell id="T1_h" value="&lt;b&gt;TẦNG 1: TRÌNH DIỄN (CLIENT TIER) - Container: freelance-frontend (cổng 3000)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontColor=#000000;fontSize=11;align=left;fontSize=12;" vertex="1" parent="T1">
          <mxGeometry x="12" y="6" width="1090" height="26" as="geometry" />
        </mxCell>
        <mxCell id="T1_0" value="React 18 + TypeScript + Vite&lt;br&gt;(Single Page Application)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="T1">
          <mxGeometry x="20" y="44" width="255" height="76" as="geometry" />
        </mxCell>
        <mxCell id="T1_1" value="AuthContext&lt;br&gt;(user, token, role lưu trong localStorage)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="T1">
          <mxGeometry x="295" y="44" width="255" height="76" as="geometry" />
        </mxCell>
        <mxCell id="T1_2" value="ProtectedRoute (Route Guard)&lt;br&gt;/student/*, /employer/*, /post-job, /admin/*" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="T1">
          <mxGeometry x="570" y="44" width="255" height="76" as="geometry" />
        </mxCell>
        <mxCell id="T1_3" value="apiClient (Axios Interceptor)&lt;br&gt;Gắn Bearer JWT; HTTP 401 → về trang đăng nhập" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="T1">
          <mxGeometry x="845" y="44" width="255" height="76" as="geometry" />
        </mxCell>
        <mxCell id="T2" value="" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="382" width="1120" height="226" as="geometry" />
        </mxCell>
        <mxCell id="T2_h" value="&lt;b&gt;TẦNG 2: NGHIỆP VỤ (APPLICATION TIER) - Java 17/21, Spring Boot 3.2.x - Container: freelance-backend (cổng 8080)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontColor=#000000;fontSize=11;align=left;fontSize=12;" vertex="1" parent="T2">
          <mxGeometry x="12" y="6" width="1090" height="26" as="geometry" />
        </mxCell>
        <mxCell id="T2_0" value="CorsFilter&lt;br&gt;(Kiểm tra domain được phép)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="T2">
          <mxGeometry x="20" y="44" width="140" height="76" as="geometry" />
        </mxCell>
        <mxCell id="T2_1" value="JwtAuthenticationFilter&lt;br&gt;(JwtTokenProvider, HS256)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="T2">
          <mxGeometry x="174" y="44" width="165" height="76" as="geometry" />
        </mxCell>
        <mxCell id="T2_2" value="SecurityFilterChain&lt;br&gt;(RBAC theo URL &amp;amp; Role: 401 / 403)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="T2">
          <mxGeometry x="353" y="44" width="175" height="76" as="geometry" />
        </mxCell>
        <mxCell id="T2_3" value="Controllers (8 lớp)&lt;br&gt;Auth, Job, Application, Review,&lt;br&gt;Notification, User, Category, Admin" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="T2">
          <mxGeometry x="542" y="44" width="230" height="76" as="geometry" />
        </mxCell>
        <mxCell id="T2_4" value="Services&lt;br&gt;(100% logic nghiệp vụ)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="T2">
          <mxGeometry x="786" y="44" width="150" height="76" as="geometry" />
