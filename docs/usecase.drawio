        <mxCell id="lg_t0" value="Association (nét liền): tác nhân tham gia trực tiếp vào use case." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontColor=#000000;fontSize=11;align=left;" vertex="1" parent="1">
