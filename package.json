    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "test:backend": "cd backend && mvn test",
    "test:frontend": "cd frontend && npm run build"
  },
  "keywords": [
    "freelance",
    "part-time",
    "spring-boot",
    "react",
    "vite",
    "docker",
    "postgresql",
    "cdtn2"
  ],
