{
  "name": "cdtn2-nhom8-freelance-platform",
  "version": "1.0.0",
  "description": "Nền tảng Tuyển dụng Sinh viên Freelance & Part-time (CDTN2 - Nhóm 8)",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down -v",
